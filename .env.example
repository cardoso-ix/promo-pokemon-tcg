# =====================================================================
# PROMO POKÉMON TCG - VARIÁVEIS DE AMBIENTE (LOCAL / VPS / COOLIFY)
# =====================================================================
# Dica: No novo computador, este arquivo é copiado automaticamente para .env
# pelo script setup-novo-pc.bat / setup-novo-pc.sh.
# As configurações padrão abaixo já funcionam perfeitamente no ambiente local.

# --------------------------------------------------
# 1. SEGURANÇA E AUTENTICAÇÃO DOS PAINÉIS WEB
# --------------------------------------------------
# Usuário de acesso aos dashboards (Replicador e Disparador)
ADMIN_USER=admin
# Senha forte de acesso ao painel (padrão local: promo2026 | altere na VPS!)
ADMIN_PASS=promo2026
# Chave secreta para assinatura dos cookies HMAC-SHA256 (Mínimo 32 caracteres)
SESSION_SECRET=promo-pokemon-tcg-secret-session-key-2026-secure-token

# --------------------------------------------------
# 2. PONTE DE COMUNICAÇÃO INTERNA ENTRE SERVIÇOS
# --------------------------------------------------
# Token secreto para autenticação na comunicação entre Replicador e Disparador
INTERNAL_API_KEY=promo-internal-key-2026
# URL do Bot Disparador acessível pelo Replicador
# Em desenvolvimento local: http://localhost:3333
# Em produção Docker (Coolify): http://bot-disparador:3333
DISPARADOR_URL=http://localhost:3333
# Ativar ou desativar o repasse de ofertas replicadas para o disparador
SYNC_DISPARADOR=true

# --------------------------------------------------
# 3. REPLICADOR DE OFERTAS (AFILIADOS MERCADO LIVRE)
# --------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Diretório de dados persistentes:
# Localmente: data
# Em produção Docker: /app/data
DATA_DIR=data
# Parâmetros de Afiliado do Mercado Livre
MATT_WORD=caed1312314
MATT_TOOL=96097202
# Cookie de sessão do Mercado Livre para API meli.la (opcional, pode ser configurado no painel)
MELI_COOKIE=
MELI_TAG=caed1312314

# --------------------------------------------------
# 4. INTEGRAÇÃO GOOGLE PLANILHAS (OPCIONAL)
# --------------------------------------------------
# Webhook do Google Apps Script para a planilha "produtos tcg valores"
# Se vazio, os registros são mantidos com segurança no banco SQLite local
GOOGLE_SHEETS_WEBHOOK_URL=

# --------------------------------------------------
# 5. BOT DISPARADOR & ATENDIMENTO IA (DEEPSEEK V4)
# --------------------------------------------------
DISPARADOR_PORT=3333
# Chave de API do OpenCode Gateway ou DeepSeek Oficial
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# --------------------------------------------------
# 6. WHATSAPP CLOUD API (META OFICIAL - OPCIONAL)
# --------------------------------------------------
# Apenas caso utilize envio oficial via Meta Cloud API além do Baileys
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# --------------------------------------------------
# 7. CONFIGURAÇÃO DE DOMÍNIOS NO COOLIFY / TRAEFIK (PRODUÇÃO)
# --------------------------------------------------
# Domínio público do Replicador (ex: promo.seudominio.com.br)
PROMO_DOMAIN=promo.seudominio.com
# Domínio público do Disparador (ex: disparador.seudominio.com.br)
DISPARADOR_DOMAIN=disparador.seudominio.com
