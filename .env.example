# =====================================================================
# PROMO POKÉMON TCG - VARIÁVEIS DE AMBIENTE (COOLIFY / VPS / LOCAL)
# =====================================================================

# --------------------------------------------------
# 1. SEGURANÇA E AUTENTICAÇÃO DOS PAINÉIS WEB
# --------------------------------------------------
# Usuário de acesso aos dashboards (Replicador e Disparador)
ADMIN_USER=eduardo
# Senha forte de acesso ao painel (Altere em produção!)
ADMIN_PASS=SuaSenhaForteAqui2026!
# Chave secreta para assinatura dos cookies HMAC (Mínimo 32 caracteres aleatórios)
SESSION_SECRET=coloque-aqui-uma-chave-secreta-longa-e-aleatoria-para-producao

# --------------------------------------------------
# 2. PONTE DE COMUNICAÇÃO INTERNA ENTRE SERVIÇOS
# --------------------------------------------------
# Token secreto para autenticação na rede interna Docker
INTERNAL_API_KEY=sua-chave-interna-super-secreta-2026
# URL interna do Bot Disparador acessível pelo Replicador na rede Docker
DISPARADOR_URL=http://bot-disparador:3333
# Ativar ou desativar o repasse de ofertas replicadas para o disparador
SYNC_DISPARADOR=true

# --------------------------------------------------
# 3. REPLICADOR DE OFERTAS (AFILIADOS MERCADO LIVRE)
# --------------------------------------------------
PORT=3000
HOST=0.0.0.0
DATA_DIR=/app/data
# Parâmetros de Afiliado do Mercado Livre
MATT_WORD=caed1312314
MATT_TOOL=96097202
# Cookie de sessão do Mercado Livre para API meli.la (opcional, pode ser configurado no painel)
MELI_COOKIE=
MELI_TAG=caed1312314

# --------------------------------------------------
# 4. BOT DISPARADOR & ATENDIMENTO IA (DEEPSEEK V4)
# --------------------------------------------------
DISPARADOR_PORT=3333
# Chave de API do OpenCode Gateway ou DeepSeek Oficial
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# --------------------------------------------------
# 5. WHATSAPP CLOUD API (META OFICIAL - OPCIONAL)
# --------------------------------------------------
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# --------------------------------------------------
# 6. CONFIGURAÇÃO DE DOMÍNIOS NO COOLIFY / TRAEFIK
# --------------------------------------------------
# Domínio público do Replicador (ex: promo.seudominio.com.br)
PROMO_DOMAIN=promo.seudominio.com
# Domínio público do Disparador (ex: disparador.seudominio.com.br)
DISPARADOR_DOMAIN=disparador.seudominio.com
