# Modelo do .env do projeto Docker "evolution-api" na VPS.
# O arquivo real vive so na VPS (Docker Manager) e NUNCA entra no git.

# Chave que protege a API da Evolution. Gere uma nova, longa e aleatoria:
#   openssl rand -hex 32
# O n8n usa essa mesma chave no header apikey do node "Baixar Imagem da Evolution".
EVOLUTION_API_KEY=

# Conexao com o Postgres do bot, em schema separado para nao misturar tabelas.
# Host = nome do container do Postgres na rede n8n_default (pokemon-postgres).
# IMPORTANTE: percent-encode a senha ($ vira %24, # vira %23, @ vira %40). A senha atual
# tem um $, e $ nao escapado ja foi engolido pelo Docker Compose neste projeto uma vez.
EVOLUTION_DATABASE_URI=postgresql://pokemon_bot:SENHA_ENCODED@pokemon-postgres:5432/pokemon_promos?schema=evolution

# Webhook do workflow Replica WhatsApp Ingest (caminho com segredo, nao divulgar).
#
# Endereco INTERNO, pela rede docker. Nao use o dominio publico: de dentro do container o
# nome srv1897392.hstgr.cloud resolve para 127.0.1.1, e o webhook morre com ECONNREFUSED.
# Falar direto com o n8n tambem evita uma volta desnecessaria pela internet e pelo TLS.
EVOLUTION_WEBHOOK_URL=http://n8n:5678/webhook/replica/wa-c7a6b94011594f119a
